# Never expose ERP credentials through NEXT_PUBLIC_ variables.
DATA_ADAPTER=api
ERP_API_BASE_URL=http://localhost:3000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Only URL and anon/publishable key belong in this project. Never copy service_role.
# Supabase Auth redirect allowlist: http://localhost:3001/auth/confirm
# Owner invitations redirect to /auth/confirm?next=/definir-senha.
# Official customer contact. WhatsApp must include country code (e.g. 55), no spaces.
NEXT_PUBLIC_CONTACT_WHATSAPP=5583999123337
NEXT_PUBLIC_CONTACT_EMAIL=
